# Timezone for Home Assistant
TZ=Europe/Warsaw

# Active host network interface for Matter & OpenThread Border Router (e.g. eth0, wlan0)
BACKBONE_IF=<NETWORK_INTERFACE>

# Persistent path to Thread RCP USB coordinator (e.g. /dev/ttyUSB0 or /dev/serial/by-id/<USB_DEVICE_ID>)
ZBDONGLE_DEVICE=/dev/serial/by-id/<USB_DEVICE_ID>
